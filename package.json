{
  "name": "nova-cut-desktop",
  "productName": "NOVA CUT",
  "version": "8.4.0",
  "description": "NOVA CUT 8.4 — ULTRA CINEMA REDESIGN, NOVA SIGNATURE app icon, MP4 import and QUALITY INSPECTOR PRO.",
  "main": "main.js",
  "author": "NOVA CUT",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:win:portable": "electron-builder --win portable --x64",
    "check": "node scripts/check-project.js && node scripts/check-ui.js && node scripts/check-timeline7.js && node --check app/ultra.js && node --check app/pro-ui.js && node --check app/timeline7.js && node --check app/studio8.js && node --check speech-renderer.js && node scripts/check-studio8.js && node scripts/check-10k.js && node scripts/check-cinema.js && node --check app/quality-inspector.js && node --check media-inspector.js && node scripts/check-quality.js && node --check mp4-preview.js && node scripts/check-mp4.js && node --check app/ultra-cinema-redesign.js && node scripts/check-redesign.js",
    "prebuild:win": "npm run check"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.novacut.editor",
    "productName": "NOVA CUT",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "assets/**/*",
      "main.js",
      "preload.js",
      "native-renderer.js",
      "package.json",
      "speech-renderer.js",
      "render-guard.js",
      "cinema-engine.js",
      "media-inspector.js",
      "mp4-preview.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/novacut.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "NOVA-CUT-8.4-ULTRA-CINEMA-Setup-${version}.${ext}",
      "installerIcon": "assets/novacut.ico",
      "uninstallerIcon": "assets/novacut.ico",
      "installerHeaderIcon": "assets/novacut.ico"
    },
    "portable": {
      "artifactName": "NOVA-CUT-8.4-ULTRA-CINEMA-Portable-${version}.${ext}"
    },
    "publish": null,
    "extraResources": [
      {
        "from": "whisper",
        "to": "whisper",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
