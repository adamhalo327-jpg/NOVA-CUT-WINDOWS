{
  "name": "nova-cut-desktop",
  "productName": "NOVA CUT",
  "version": "8.1.0",
  "description": "NOVA CUT 8.1 - experimental 10K 9600x5400 export with RAM/disk/codec checks; existing 8.0 studio preserved",
  "main": "main.js",
  "author": "NOVA CUT",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:win:portable": "electron-builder --win portable --x64",
    "check": "node scripts/check-project.js && node scripts/check-ui.js && node scripts/check-timeline7.js && node --check app/ultra.js && node --check app/pro-ui.js && node --check app/timeline7.js && node --check app/studio8.js && node --check speech-renderer.js && node scripts/check-studio8.js && node scripts/check-10k.js",
    "prebuild:win": "npm run check"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.novacut.editor",
    "productName": "NOVA CUT",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "assets/**/*",
      "main.js",
      "preload.js",
      "native-renderer.js",
      "package.json",
      "speech-renderer.js",
      "render-guard.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/novacut.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "NOVA-CUT-8.1-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "NOVA-CUT-8.1-Portable-${version}.${ext}"
    },
    "publish": null,
    "extraResources": [
      {
        "from": "whisper",
        "to": "whisper",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
